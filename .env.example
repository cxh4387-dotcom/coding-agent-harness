# .env.example
# Coding Agent Harness - Environment Variables
#
# WARNING: .env files are plaintext. Anyone with file system access can read them.
# Process environment is visible to other processes. This is a convenience
# fallback only — the primary method is the encrypted vault via WebUI.
#
# Usage: Copy to .env and fill in your values. NEVER commit .env to git.

# OpenAI-compatible API key (required for real LLM calls)
HARNESS_API_KEY=sk-your-api-key-here

# LLM base URL (default: NJUSE Hub)
HARNESS_LLM_BASE_URL=https://njusehub.info/v1

# LLM model name
HARNESS_LLM_MODEL=glm-5.2
